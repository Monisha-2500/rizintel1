# Copy this file to .env and fill in your key to enable the LLM path.
# If left blank, M6 automatically and silently uses the rule-based
# fallback -- the service still works, and the demo never breaks because
# of a missing key, network issue, or rate limit.
ANTHROPIC_API_KEY=

# Check https://docs.claude.com for the current recommended model string
# at build/demo time -- model names change over time.
ANTHROPIC_MODEL=claude-sonnet-4-5

M6_LLM_TIMEOUT_SECONDS=20
M6_LLM_MAX_TOKENS=1200
