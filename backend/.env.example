# RizIntel Backend Environment Configuration Example
# Copy to .env for local deployment

# Environment: development | staging | production
RIZINTEL_ENV=development

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated or * in development)
RIZINTEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQLite Database Location
RIZINTEL_DATABASE_PATH=backend/data/audit_trail.db

# Storage Path for Raw Scanner Submissions
RIZINTEL_STORAGE_PATH=backend/data/submissions

# Public Service URL
RIZINTEL_PUBLIC_URL=http://127.0.0.1:8000

# Logging Level: DEBUG | INFO | WARNING | ERROR
RIZINTEL_LOG_LEVEL=INFO

# JWT Secret (Override in production!)
RIZINTEL_JWT_SECRET=change-this-in-production-security-secret-key-32bytes
