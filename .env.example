# ══════════════════════════════════════════════════════════════════════════════
# RizIntel Environment Configuration Template
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit production secrets or real API keys to source control.
# ══════════════════════════════════════════════════════════════════════════════

# Environment: development | production | test
RIZINTEL_ENV=development

# Server Binding
HOST=0.0.0.0
PORT=8000

# JWT Authentication (REQUIRED in production)
# Generate a strong 256-bit random key in production, e.g. using: openssl rand -hex 32
RIZINTEL_JWT_SECRET=your-secure-production-jwt-secret-key-here-minimum-32-chars
RIZINTEL_JWT_EXPIRE_MINUTES=120

# Demo User Default Passwords (override if desired for demo staging)
RIZINTEL_DEMO_VIEWER_PASSWORD=Viewer2026!
RIZINTEL_DEMO_ANALYST_PASSWORD=Analyst2026!
RIZINTEL_DEMO_LEAD_PASSWORD=Lead2026!
RIZINTEL_DEMO_ADMIN_PASSWORD=Admin2026!

# CORS Allowed Origins (comma-separated URLs or wildcard for local development)
RIZINTEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQLite Database Storage Location (Defaults to backend/data/audit_trail.db)
# RIZINTEL_DB_PATH=/var/data/audit_trail.db

# Frontend API URL (for Vite build)
VITE_API_URL=http://localhost:8000/api
